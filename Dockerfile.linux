FROM ubuntu:26.04

ENV DEBIAN_FRONTEND=noninteractive

# install all linux packages
RUN apt-get update && apt-get install -y \
    build-essential \
    sbcl \
    curl \
    git \
    bzip2 \
    libsdl2-dev \
    libsdl2-mixer-dev \
    libncursesw5-dev \
    libzstd-dev \
    file \
    tar \
    gzip \
    && rm -rf /var/lib/apt/lists/*

# install sbcl
#   use the prebuilt binary as a bootstrap compiler
#   to build it again with zstd compression enabled
ENV SBCL_VERSION=2.6.7
RUN mkdir -p /tmp/sbcl-build && \
    curl -Lo /tmp/sbcl-src.tar.bz2 https://sourceforge.net/projects/sbcl/files/sbcl/${SBCL_VERSION}/sbcl-${SBCL_VERSION}-source.tar.bz2/download && \
    tar -xjf /tmp/sbcl-src.tar.bz2 -C /tmp/sbcl-build && \
    cd /tmp/sbcl-build/sbcl-${SBCL_VERSION} && \
    export LINKFLAGS="-Wl,-Bstatic -lzstd -Wl,-Bdynamic" && \
    sh make.sh \
      --xc-host="sbcl --no-userinit --no-sysinit" \
      --with-sb-core-compression && \
    sh install.sh && \
    rm -rf /tmp/sbcl-build /tmp/sbcl-src.tar.bz2

# install quicklisp
RUN curl -O https://beta.quicklisp.org/quicklisp.lisp && \
    sbcl --load quicklisp.lisp \
         --eval '(quicklisp-quickstart:install :path "/root/quicklisp")' \
         --eval '(ql-util:without-prompting (ql:add-to-init-file))' \
         --quit && \
    rm quicklisp.lisp

# install appimagetool
RUN curl -Lo /usr/local/bin/appimagetool https://github.com/appimage/appimagetool/releases/download/continuous/appimagetool-x86_64.AppImage && \
    chmod +x /usr/local/bin/appimagetool && \
    cd /tmp && \
    /usr/local/bin/appimagetool --appimage-extract && \
    mv squashfs-root /opt/appimagetool && \
    ln -s /opt/appimagetool/AppRun /usr/local/bin/appimagetool-no-fuse && \
    rm /usr/local/bin/appimagetool

# compile alacritty
ENV ALACRITTY_VER="v0.16.0"
RUN echo "Compiling Alacritty $ALACRITTY_VER..." && \
    apt-get update && apt-get install -y \
        cmake \
        pkg-config \
        libfreetype6-dev \
        libfontconfig1-dev \
        libxcb-xfixes0-dev \
        libxkbcommon-dev \
        python3 && \
    echo 'Installing Rust toolchain...' && \
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y && \
    . "$HOME/.cargo/env" && \
    mkdir -p /tmp/alacritty-src && \
    cd /tmp/alacritty-src && \
    git clone --depth 1 --branch "$ALACRITTY_VER" https://github.com/alacritty/alacritty.git . && \
    cargo build --release && \
    strip --strip-unneeded target/release/alacritty && \
    cp target/release/alacritty /opt


WORKDIR /workspace

COPY . /workspace

# build the AppImage
COPY build-scripts/build-linux-appimage.sh /usr/local/bin/build-linux-appimage.sh
RUN chmod +x /usr/local/bin/build-linux-appimage.sh

CMD ["/usr/local/bin/build-linux-appimage.sh"]
